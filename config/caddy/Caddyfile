{
    admin :2019

    security {
        state {
            directory /data/caddy/state
        }

        oauth identity provider google {
            realm google
            driver google
            client_id {env.GOOGLE_CLIENT_ID}
            client_secret {env.GOOGLE_CLIENT_SECRET}
            scopes openid email profile
        }

        authentication portal myportal {
            enable identity provider google
            cookie domain thekev.in

            ui {
                links {
                    "My Identity" /whoami icon "las la-user"
                }
            }

            transform user {
                suffix match email @thekev.in
                action add role authp/admin
            }
            transform user {
                exact match email kevin.j.carruthers@gmail.com
                action add role authp/admin
            }
        }

        authorization policy meonly {
            set auth url https://auth.thekev.in/auth/oauth2/google
            inject headers with claims

            acl rule {
                comment allow admins
                match roles authp/admin
                allow stop
            }

            acl rule {
                comment default deny
                match any
                deny log warn
            }
        }
    }

    servers {
        trusted_proxies static private_ranges
    }
}

http://auth.thekev.in {
    authenticate with myportal
}

http://bookorbit.thekev.in {
    reverse_proxy bookorbit:3000
}

http://bazarr.thekev.in {
    authorize with meonly
    reverse_proxy bazarr:6767
}

http://fava.thekev.in {
    authorize with meonly
    reverse_proxy fava:5000
}

http://home.thekev.in {
    reverse_proxy homepage:3000
}

http://immich.thekev.in {
    reverse_proxy immich-server:2283
}

http://netdata.thekev.in {
    authorize with meonly
    reverse_proxy netdata:19999
}

http://n8n.thekev.in {
    reverse_proxy n8n:5678
}

