    authorize with meonly
    reverse_proxy prowlarr:9696
}

http://qbittorrent.thekev.in {
    authorize with meonly
    reverse_proxy qbittorrent:8080
}

http://radarr.thekev.in {
    authorize with meonly
    reverse_proxy radarr:7878
}

http://sonarr.thekev.in {
