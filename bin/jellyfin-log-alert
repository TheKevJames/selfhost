#!/usr/bin/env bash
# Posts a Discord alert when Jellyfin's log shows clustered client-connectivity
# errors (WebSocket drops / Kestrel send-timeouts) in a rolling window. This
# catches a *client-side* symptom (usually a TV dropping mid-stream) that
# neither dolce (container events) nor netdata (metrics) can see, since it
# lives only in Jellyfin's app log.
#
# Triggers when EITHER:
#   * a "strong" signal appears (server could not push to the client), OR
#   * "weak" signals cluster (>= WEAK_THRESHOLD in WINDOW).
#
# At most one alert per COOLDOWN_SECONDS. Reads via `docker logs --since` on
# purpose: /config/log is an anonymous volume whose host path changes on every
# container recreation, so path-based tailing would silently break.
set -euo pipefail

CONTAINER="${JELLYFIN_CONTAINER:-jellyfin}"
WINDOW="${JELLYFIN_ALERT_WINDOW:-10m}"
WEAK_THRESHOLD="${JELLYFIN_ALERT_WEAK_THRESHOLD:-3}"
COOLDOWN_SECONDS="${JELLYFIN_ALERT_COOLDOWN:-1800}"
# systemd sets STATE_DIRECTORY (StateDirectory=); fall back for manual runs.
STATE_DIR="${STATE_DIRECTORY:-/var/lib/jellyfin-log-alert}"

STRONG_RE='SocketException \(110\)|TimingPipeFlusher'
WEAK_RE='remote party closed the WebSocket|Lost [0-9]+ WebSocket'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
. "$SCRIPT_DIR/lib/alert.sh"

log() { printf 'jellyfin-log-alert: %s\n' "$*" >&2; }

alert_load_webhook || exit 1

mkdir -p "$STATE_DIR"

# Serialize overlapping timer runs.
exec 9>"$STATE_DIR/lock"
flock -n 9 || { log "another run holds the lock, skipping"; exit 0; }

logs="$(docker logs --since "$WINDOW" "$CONTAINER" 2>&1)" || {
    log "docker logs failed for container '$CONTAINER'"
    exit 1
}

strong_count="$(grep -Ec "$STRONG_RE" <<<"$logs" || true)"
weak_count="$(grep -Ec "$WEAK_RE" <<<"$logs" || true)"

triggered=0
if [ "$strong_count" -ge 1 ]; then
    triggered=1
fi
if [ "$weak_count" -ge "$WEAK_THRESHOLD" ]; then
    triggered=1
fi

if [ "$triggered" -eq 0 ]; then
    log "ok (strong=$strong_count weak=$weak_count window=$WINDOW)"
    exit 0
fi

now="$(date +%s)"
last_alert_file="$STATE_DIR/last-alert"
if [[ -f "$last_alert_file" ]]; then
    last="$(cat "$last_alert_file" 2>/dev/null || echo 0)"
    if [ "$((now - last))" -lt "$COOLDOWN_SECONDS" ]; then
        remaining="$((COOLDOWN_SECONDS - (now - last)))"
        log "within cooldown (${remaining}s left), skipping"
        exit 0
    fi
fi

# Attribute to client(s): only the weak WS lines carry an IP; strong Kestrel
# send-timeouts do not.
clients="$(grep -oE 'WS "[0-9]{1,3}(\.[0-9]{1,3}){3}"' <<<"$logs" \
    | grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' \
    | sort | uniq -c | sort -rn \
    | awk '{printf "%s (x%s) ", $2, $1}')"
if [ -z "$clients" ]; then
    clients="unknown (server-side timeout; no client IP)"
fi

last_line="$(grep -E "$STRONG_RE|$WEAK_RE" <<<"$logs" | tail -n1)"

total="$((strong_count + weak_count))"
counts="strong=${strong_count}, weak=${weak_count}"
printf -v msg '%s\n%s\n%s\n%s' \
    "⚠️ **Jellyfin client connectivity** — ${total} error(s) (${counts})" \
    "Window: last ${WINDOW}. Client(s): ${clients}" \
    "Likely a client-side network/WiFi drop, not a server crash." \
    "Last: ${last_line}"

alert "$msg" || { log "discord POST failed"; exit 1; }

printf '%s\n' "$now" > "$last_alert_file"
log "alert sent (strong=$strong_count weak=$weak_count clients=[$clients])"
