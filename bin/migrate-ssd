#!/usr/bin/env bash
# One-time migration: relocate the write-heavy state of this box off the
# wear-prone SD/eMMC root and onto an internal SATA SSD, to spare the SD card's
# limited write endurance and free its near-full root filesystem.
#
# Moves, and how each is rewired to its new home on the SSD (/mnt/ssd):
#   * Docker root  /var/lib/docker  -> /mnt/ssd/docker   (daemon `data-root`)
#   * ~/src        (repo + data/)   -> /mnt/ssd/src      (fstab bind-mount)
#   * /var/log                      -> /mnt/ssd/var-log  (fstab bind-mount)
#   * swap                          -> /mnt/ssd/swapfile (SD swap disabled)
#
# Runs as a sequence of idempotent, individually invokable phases with a
# confirmation gate before each destructive step, so you can inspect between
# them and safely re-run. Copies (rsync) rather than moves: the SD originals are
# renamed aside (*.old) and only removed by the explicit `reclaim` phase, after
# a reboot test proves the new wiring survives a cold boot.
#
# Usage:
#   sudo bin/migrate-ssd status         # show current state, make no changes
#   sudo bin/migrate-ssd all            # run preflight..verify with gates
#   sudo bin/migrate-ssd <phase>        # run a single phase
#   sudo bin/migrate-ssd reclaim        # delete the *.old originals (deferred)
#   sudo bin/migrate-ssd rollback       # revert wiring (originals must remain)
#
# Phases (in order): preflight prune backup-db partition swap stop copy rewire
#                    up verify   then, later: reboot-test reclaim
#
# Honour ASSUME_YES=1 to skip interactive gates (for a hands-off re-run).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname -- "$SCRIPT_DIR")"
# ~/src is the grandparent of the repo (.../src/personal/selfhost); derived so
# there is no hard-coded username. This is the directory relocated to the SSD.
SRC_DIR="$(dirname -- "$(dirname -- "$REPO_DIR")")"

SSD_MNT="${SSD_MNT:-/mnt/ssd}"
SSD_LABEL="${SSD_LABEL:-ssd}"
SWAP_SIZE_MIB="${SWAP_SIZE_MIB:-8192}"
DOCKER_ROOT="$SSD_MNT/docker"
SSD_SRC="$SSD_MNT/src"
SSD_VARLOG="$SSD_MNT/var-log"
SWAPFILE="$SSD_MNT/swapfile"
BACKUP_DIR="${BACKUP_DIR:-/mnt/8tb/premigration}"
FSTAB=/etc/fstab
FSTAB_BEGIN='# >>> migrate-ssd managed >>>'
FSTAB_END='# <<< migrate-ssd managed <<<'
STAMP="$(date +%Y%m%d-%H%M%S)"

log() { printf 'migrate-ssd: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

confirm() {
    [[ "${ASSUME_YES:-0}" == 1 ]] && return 0
    local reply
    read -r -p "migrate-ssd: $1 [y/N] " reply
    [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

require_root() { [[ "$(id -u)" == 0 ]] || die "must run as root (use: sudo $0 $*)"; }

# The compose stack and docker CLI must act as the repo owner, not root, so
# bind-mount ownership and any user-scoped docker context stay correct.
OWNER="${SUDO_USER:-$(stat -c '%U' "$REPO_DIR")}"
as_owner() { sudo -u "$OWNER" "$@"; }
compose() { as_owner env -C "$REPO_DIR" docker compose "$@"; }

# Resolve the target disk by hardware identity (internal SATA, non-rotational,
# no existing partitions) rather than a kernel name like /dev/sda, which can be
# reassigned to a USB disk across reboots -- guarding against wiping the wrong
# drive.
resolve_ssd_disk() {
    local name tran rota parts cand=()
    while read -r name tran rota; do
        [[ "$tran" == sata && "$rota" == 0 ]] || continue
        parts="$(lsblk -rno NAME "/dev/$name" | tail -n +2)"
        [[ -z "$parts" ]] && cand+=("/dev/$name")
    done < <(lsblk -dno NAME,TRAN,ROTA)
    [[ "${#cand[@]}" == 1 ]] || die "expected exactly one blank SATA SSD, found: ${cand[*]:-none}"
    printf '%s\n' "${cand[0]}"
}

ssd_partition() {
    local disk=$1
    [[ "$disk" == *[0-9] ]] && printf '%sp1\n' "$disk" || printf '%s1\n' "$disk"
}

partition_by_label() { blkid -L "$SSD_LABEL" 2>/dev/null || true; }

# ---------------------------------------------------------------------------

phase_preflight() {
    log "hostname=$(hostname) owner=$OWNER repo=$REPO_DIR src=$SRC_DIR"
    command -v docker >/dev/null || die "docker not found"
    [[ -f "$REPO_DIR/docker-compose.yml" ]] || die "no compose file at $REPO_DIR"
    mountpoint -q "$(dirname "$BACKUP_DIR")" || log "WARN: $(dirname "$BACKUP_DIR") is not a mountpoint (DB dump target)"
    if [[ -e "$(partition_by_label)" ]]; then
        log "SSD already formatted (label=$SSD_LABEL) -- partition/format will be skipped"
    else
        local disk; disk="$(resolve_ssd_disk)"
        log "target SSD resolved to: $disk"
        lsblk -o NAME,SIZE,TYPE,FSTYPE,MODEL,TRAN "$disk"
    fi
    log "preflight ok"
}

phase_prune() {
    log "pruning dangling docker data (frees space before the copy)"
    as_owner docker system df
    confirm "run 'docker system prune -f'?" || { log "skipped prune"; return 0; }
    as_owner docker system prune -f
}

phase_backup-db() {
    as_owner docker ps --format '{{.Names}}' | grep -qx immich-postgres \
        || die "immich-postgres not running; cannot dump (run this before 'stop')"
    mkdir -p "$BACKUP_DIR"
    local pguser out
    pguser="$(as_owner docker exec immich-postgres printenv POSTGRES_USER 2>/dev/null || echo postgres)"
    out="$BACKUP_DIR/immich-postgres-$STAMP.sql.gz"
    log "dumping immich Postgres (user=$pguser) -> $out"
    as_owner docker exec -t immich-postgres pg_dumpall -U "$pguser" | gzip > "$out"
    log "dump complete: $(du -h "$out" | cut -f1)"
}

phase_partition() {
    local part; part="$(partition_by_label)"
    if [[ -n "$part" ]]; then
        log "SSD already has labelled ext4 partition ($part) -- skipping format"
    else
        local disk; disk="$(resolve_ssd_disk)"
        log "about to DESTROY ALL DATA on $disk and create a single ext4 partition"
        lsblk -o NAME,SIZE,TYPE,FSTYPE,MODEL,TRAN "$disk"
        confirm "FORMAT $disk? this is irreversible" || die "aborted by user"
        wipefs -a "$disk"
        sgdisk -Z -n 1:0:0 -t 1:8300 -c 1:"$SSD_LABEL" "$disk"
        partprobe "$disk"; udevadm settle
        part="$(ssd_partition "$disk")"
        mkfs.ext4 -L "$SSD_LABEL" "$part"
    fi
    mkdir -p "$SSD_MNT"
    fstab_set "$SSD_MNT" "UUID=$(blkid -s UUID -o value "$part") $SSD_MNT ext4 defaults,noatime,nofail 0 2"
    systemctl daemon-reload
    mountpoint -q "$SSD_MNT" || mount "$SSD_MNT"
    log "mounted: $(findmnt -no SOURCE,TARGET,FSTYPE "$SSD_MNT")"
}

phase_swap() {
    mountpoint -q "$SSD_MNT" || die "$SSD_MNT not mounted; run 'partition' first"
    if ! swapon --show=NAME --noheadings | grep -qx "$SWAPFILE"; then
        if [[ ! -f "$SWAPFILE" ]]; then
            log "creating ${SWAP_SIZE_MIB}MiB swapfile at $SWAPFILE"
            fallocate -l "${SWAP_SIZE_MIB}M" "$SWAPFILE" \
                || dd if=/dev/zero of="$SWAPFILE" bs=1M count="$SWAP_SIZE_MIB" status=progress
            chmod 600 "$SWAPFILE"
            mkswap "$SWAPFILE"
        fi
        swapon "$SWAPFILE"
    fi
    log "disabling SD-backed swap (/swapfile and any swap partition)"
    [[ -f /swapfile ]] && { swapoff /swapfile 2>/dev/null || true; rm -f /swapfile; }
    while read -r dev; do swapoff "$dev" 2>/dev/null || true; done \
        < <(swapon --show=NAME --noheadings | grep -v "^$SWAPFILE\$" || true)
    fstab_disable_old_swap
    fstab_set "$SWAPFILE" "$SWAPFILE none swap sw,nofail 0 0"
    swapon --show
}

phase_stop() {
    log "stopping the compose stack, then the docker daemon"
    compose down
    systemctl stop docker.socket docker
    log "docker stopped"
}

phase_copy() {
    systemctl is-active --quiet docker && die "docker still running; run 'stop' first"
    mountpoint -q "$SSD_MNT" || die "$SSD_MNT not mounted"
    rsync_tree /var/lib/docker/ "$DOCKER_ROOT/"
    rsync_tree "$SRC_DIR/"      "$SSD_SRC/"
    rsync_tree /var/log/        "$SSD_VARLOG/"
    log "copy complete"
}

phase_rewire() {
    [[ -d "$DOCKER_ROOT" && -d "$SSD_SRC" && -d "$SSD_VARLOG" ]] || die "copy targets missing; run 'copy' first"
    install -D -m 0644 "$REPO_DIR/sys/daemon.json" /etc/docker/daemon.json
    install -D -m 0644 "$REPO_DIR/sys/docker-ssd.conf" /etc/systemd/system/docker.service.d/ssd.conf

    fstab_set "$SRC_DIR"  "$SSD_SRC $SRC_DIR none bind,nofail,x-systemd.requires-mounts-for=$SSD_MNT 0 0"
    fstab_set /var/log    "$SSD_VARLOG /var/log none bind,nofail,x-systemd.requires-mounts-for=$SSD_MNT 0 0"

    retire_original /var/lib/docker
    retire_original "$SRC_DIR"
    retire_original /var/log

    systemctl daemon-reload
    mountpoint -q "$SRC_DIR" || mount "$SRC_DIR"
    mountpoint -q /var/log || mount /var/log
    systemctl restart systemd-journald
    systemctl start docker
    local root; root="$(as_owner docker info -f '{{.DockerRootDir}}')"
    [[ "$root" == "$DOCKER_ROOT" ]] || die "docker root is '$root', expected '$DOCKER_ROOT'"
    log "rewired: docker root=$root, binds active"
}

phase_up() {
    compose up -d --remove-orphans
    log "stack started"
}

phase_verify() {
    log "== findmnt =="; findmnt -no SOURCE,TARGET "$SSD_MNT" "$SRC_DIR" /var/log
    log "== docker root =="; as_owner docker info -f '{{.DockerRootDir}}'
    log "== swap =="; swapon --show
    log "== containers =="; as_owner docker ps --format '{{.Names}}\t{{.Status}}'
    log "== disk usage =="; df -h / "$SSD_MNT"
    log "verify: confirm all containers healthy, then run 'reboot-test'"
}

phase_reboot-test() {
    log "reboot the box, then re-run: sudo $0 verify"
    log "only once a cold boot comes up clean should you run: sudo $0 reclaim"
}

phase_reclaim() {
    local d
    for d in /var/lib/docker.old "$SRC_DIR.old" /var/log.old; do
        [[ -e "$d" ]] || continue
        confirm "delete $d ($(du -sh "$d" 2>/dev/null | cut -f1))?" || { log "kept $d"; continue; }
        rm -rf "$d"
        log "removed $d"
    done
    df -h /
}

phase_rollback() {
    [[ -e /var/lib/docker.old && -e "$SRC_DIR.old" ]] || die "originals (*.old) missing; cannot roll back"
    log "rolling back to SD-backed layout"
    compose down 2>/dev/null || true
    systemctl stop docker.socket docker || true
    umount "$SRC_DIR" /var/log 2>/dev/null || true
    swapoff "$SWAPFILE" 2>/dev/null || true
    fstab_remove_managed
    rm -f /etc/systemd/system/docker.service.d/ssd.conf
    restore_original /var/lib/docker
    restore_original "$SRC_DIR"
    restore_original /var/log
    systemctl daemon-reload
    systemctl start docker
    log "rolled back; review /etc/docker/daemon.json (data-root) and swap manually"
}

phase_status() {
    log "SSD label $SSD_LABEL -> $(partition_by_label || echo '<not formatted>')"
    findmnt -no SOURCE,TARGET "$SSD_MNT" 2>/dev/null || log "$SSD_MNT not mounted"
    findmnt -no SOURCE,TARGET "$SRC_DIR" 2>/dev/null || true
    findmnt -no SOURCE,TARGET /var/log 2>/dev/null || true
    swapon --show 2>/dev/null || true
    as_owner docker info -f 'docker root: {{.DockerRootDir}}' 2>/dev/null || true
}

# ---------------------------------------------------------------------------

rsync_tree() {
    log "rsync $1 -> $2"
    mkdir -p "$2"
    rsync -aHAXS --numeric-ids --info=progress2 "$1" "$2"
}

# Rename the SD-card original aside so it survives as a rollback source and the
# empty target becomes the bind-mount point (or, for docker, the freed path).
retire_original() {
    local path=$1
    [[ -e "$path.old" ]] && { log "$path.old already exists -- leaving as-is"; }
    if [[ ! -L "$path" ]] && ! mountpoint -q "$path" && [[ ! -e "$path.old" ]]; then
        mv "$path" "$path.old"
    fi
    mkdir -p "$path"
}

restore_original() {
    local path=$1
    [[ -e "$path.old" ]] || return 0
    [[ -e "$path" && ! -e "$path.old.replaced" ]] && rm -rf "$path"
    mv "$path.old" "$path"
}

fstab_backup_once() { [[ -f "$FSTAB.premigration" ]] || cp "$FSTAB" "$FSTAB.premigration"; }

# Upsert a single managed line keyed by mount point, kept inside a marker block
# so re-runs replace rather than duplicate, and `rollback` can excise it whole.
fstab_set() {
    local key=$1 line=$2
    fstab_backup_once
    fstab_ensure_block
    sed -i -E "\#(^|[[:space:]])${key}[[:space:]]#d" "$FSTAB"
    sed -i "/$FSTAB_END/i $line" "$FSTAB"
}

fstab_ensure_block() {
    grep -qF "$FSTAB_BEGIN" "$FSTAB" && return 0
    printf '%s\n%s\n' "$FSTAB_BEGIN" "$FSTAB_END" >> "$FSTAB"
}

fstab_remove_managed() {
    fstab_backup_once
    sed -i "/$FSTAB_BEGIN/,/$FSTAB_END/d" "$FSTAB"
}

# Comment out any pre-existing swap entry (SD swapfile / swap partition) that
# lives outside our managed block, so only the SSD swapfile remains active.
fstab_disable_old_swap() {
    fstab_backup_once
    sed -i -E "/$FSTAB_BEGIN/,/$FSTAB_END/!{/^[^#].*[[:space:]]swap[[:space:]]/s/^/# migrate-ssd disabled: /}" "$FSTAB"
}

# ---------------------------------------------------------------------------

run_all() {
    local p
    for p in preflight prune backup-db partition swap stop copy rewire up verify; do
        confirm "proceed with phase: $p ?" || die "stopped before '$p'"
        "phase_$p"
    done
    log "all phases done -- reboot, run 'verify', then 'reclaim'"
}

main() {
    local cmd="${1:-status}"
    case "$cmd" in
        status) phase_status ;;
        all) require_root "$@"; run_all ;;
        preflight|prune|backup-db|partition|swap|stop|copy|rewire|up|verify|reboot-test|reclaim|rollback)
            [[ "$cmd" == status ]] || require_root "$@"
            "phase_$cmd" ;;
        *) die "usage: $0 {status|all|preflight|prune|backup-db|partition|swap|stop|copy|rewire|up|verify|reboot-test|reclaim|rollback}" ;;
    esac
}

main "$@"
